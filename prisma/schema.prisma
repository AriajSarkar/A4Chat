generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model ProviderSetting {
  id        String   @id
  label     String
  baseUrl   String   @map("base_url")
  apiKey    String?  @map("api_key")
  model     String   @default("")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  conversations  Conversation[]
  providerModels ProviderModel[]

  @@map("provider_settings")
}

model ProviderModel {
  providerId  String  @map("provider_id")
  modelId     String  @map("model_id")
  displayName String  @default("") @map("display_name")
  isFavorite  Boolean @default(false) @map("is_favorite")
  lastSeenAt  Int     @map("last_seen_at")

  provider ProviderSetting @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@id([providerId, modelId])
  @@index([providerId])
  @@map("provider_models")
}

model Conversation {
  id         String   @id
  title      String
  providerId String   @map("provider_id")
  model      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  provider ProviderSetting @relation(fields: [providerId], references: [id])
  messages Message[]

  @@index([updatedAt(sort: Desc)])
  @@map("conversations")
}

model Message {
  id             String   @id
  conversationId String   @map("conversation_id")
  role           String
  content        String
  reasoning      String?
  tokenCount     Int?     @map("token_count")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Asc)])
  @@map("messages")
}
