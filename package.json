{
  "name": "a4chat",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/prisma-sync.mjs",
    "dev": "next dev --hostname 0.0.0.0",
    "dev:web": "next dev",
    "build": "next build",
    "build:tauri": "node scripts/tauri-build.mjs",
    "start": "next start",
    "comfy:start": "node scripts/comfy-start.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt src tests && cd src-tauri && cargo fmt --all",
    "check": "pnpm lint:rust && pnpm test",
    "test": "pnpm test:ts && pnpm test:rust",
    "test:ts": "vitest run",
    "test:ts:watch": "vitest",
    "test:rust": "cd src-tauri && cargo test --all-targets",
    "test:rust:verbose": "cd src-tauri && cargo test --all-targets -- --nocapture",
    "lint:rust": "cd src-tauri && cargo fmt --check && cargo clippy -- -D warnings",
    "version:sync": "bash scripts/sync-version.sh",
    "prisma:sync": "node scripts/prisma-sync.mjs",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --config src-tauri/tauri.conf.json",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev --config src-tauri/tauri.android.conf.json",
    "android:build:aarch64": "tauri android build --apk --target aarch64",
    "release:win": "node scripts/build-windows.mjs",
    "release:and": "node scripts/build-android.mjs aarch64",
    "release:android": "node scripts/build-android.mjs aarch64",
    "release:android:universal": "node scripts/build-android.mjs all",
    "CC": "npx @tailwindcss/upgrade --force"
  },
  "dependencies": {
    "@google/genai": "^2.6.0",
    "@lobehub/icons": "^5.8.0",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client-runtime-utils": "^7.8.0",
    "@remixicon/react": "4.9.0",
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@yudiel/react-qr-scanner": "^2.6.0",
    "better-sqlite3": "^12.10.0",
    "clsx": "2.1.1",
    "motion": "12.40.0",
    "next": "16.0.10",
    "qrcode.react": "^4.2.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@prisma/client": "7.8.0",
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.11.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "baseline-browser-mapping": "^2.10.32",
    "oxfmt": "0.51.0",
    "oxlint": "1.66.0",
    "prisma": "7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.7"
  },
  "packageManager": "pnpm@11.2.2"
}
