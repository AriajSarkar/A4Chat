{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "A4Chat",
  "version": "3.1.0",
  "identifier": "com.ariajsarkar.a4chat",
  "build": {
    "beforeDevCommand": "node scripts/dev-server.mjs",
    "beforeBuildCommand": "bash scripts/sync-version.sh && node scripts/tauri-build.mjs",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "A4Chat",
        "width": 1280,
        "height": 860,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "Productivity",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "shortDescription": "Cross-provider AI chat client",
    "longDescription": "A4Chat is a cross-platform AI chat client for OpenRouter, LM Studio, and compatible APIs."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE0OEQ5QkIwQkFGN0U1OApSV1JZZnE4THU5bElBVE9HTWxBUndZcXloVDg4TWF2VXNNMy9odGNYaDN1aGZMcDl0Y3gwTmJ5cQo=",
      "endpoints": [
        "https://github.com/AriajSarkar/A4Chat/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
